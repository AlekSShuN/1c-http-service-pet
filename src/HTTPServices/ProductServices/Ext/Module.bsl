
Функция GETProducts(Запрос)  
	
	ИмяСклада = Запрос.ПараметрыЗапроса.Получить("warehouse");
	
	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("timestamp", ТекущаяДата());
	
	Если ЗначениеЗаполнено(ИмяСклада) Тогда
		СкладСсылка = Справочники.Склады.НайтиПоНаименованию(ИмяСклада, Истина);
		Если СкладСсылка.Пустая() Тогда
			Ответ.success = Ложь;
			Ответ.Вставить("error", "Склад не найден: " + ИмяСклада);	
	        Возврат ОтветJSON(Ответ, 404); 
    КонецЕсли;
Иначе
	СкладСсылка = Неопределено;
КонецЕсли;

Запрос = Новый Запрос;

Если ЗначениеЗаполнено(СкладСсылка) Тогда
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    Остатки.Товар.Наименование КАК Товар,
    |    Остатки.Товар.Цена         КАК Цена,
    |    Остатки.Склад.Наименование КАК Склад,
    |    Остатки.КоличествоОстаток КАК Количество
    |ИЗ
    |    РегистрНакопления.ОстаткиТоваров.Остатки(
    |        &Дата,
    |        Склад = &Склад) КАК Остатки
    |ГДЕ
    |    Остатки.КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО
    |    Товар";
    Запрос.УстановитьПараметр("Склад", СкладСсылка);
Иначе
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    Остатки.Товар.Наименование КАК Товар,
    |    Остатки.Товар.Цена         КАК Цена,
    |    Остатки.Склад.Наименование КАК Склад,
    |    Остатки.КоличествоОстаток КАК Количество
    |ИЗ
    |    РегистрНакопления.ОстаткиТоваров.Остатки(&Дата) КАК Остатки
    |ГДЕ
    |    Остатки.КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО
    |    Товар";
КонецЕсли;

Запрос.УстановитьПараметр("Дата", ТекущаяДата());
Запрос.УстановитьПараметр("Склад", СкладСсылка);

Выборка = Запрос.Выполнить().Выбрать();

МассивТоваров = Новый Массив;
Пока Выборка.Следующий() Цикл
	Стр = Новый Структура;
	Стр.Вставить("name", Выборка.Товар);
    Стр.Вставить("price",     Выборка.Цена);
    Стр.Вставить("warehouse", Выборка.Склад);
    Стр.Вставить("quantity",  Выборка.Количество);
    МассивТоваров.Добавить(Стр);
КонецЦикла;

Ответ.Вставить("count", МассивТоваров.Количество());
Ответ.Вставить("products", МассивТоваров);

Возврат ОтветJSON(Ответ, 200);

КонецФункции

Функция ОтветJSON(Данные, КодСостояния)
	
	HTTPОтвет = Новый HTTPСервисОтвет(КодСостояния);
	HTTPОтвет.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ЗаписьJSON = Новый ЗаписьJSON;
	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ");
	ЗаписьJSON.УстановитьСтроку(Параметры);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	HTTPОтвет.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Возврат HTTPОтвет;
	
КонецФункции
	





